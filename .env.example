# ============================================================
# 本地开发用环境变量样例
# 使用方式：复制为 .env 并填写真实值（.env 已被 .gitignore 忽略）
# 云端部署时，这些值应配置在阿里云 FC 的「环境变量」中，不要写在文件里
#
# ⚠️ v1 范围：本仓库当前仅服务「上海臻至律师事务所」一家客户（firm_a）。
#    多账号能力已通过 accounts.json 的数组结构预留，但暂不启用。
# ============================================================

# ---- 基础 ----
DRY_RUN=true
TZ=Asia/Shanghai

# ---- 勘察用 OA 账号（阶段1 使用，任选一家即可）----
OA_USER=
OA_PASS=
OA_START_URL=https://oa.lawyers.org.cn/

# ---- 浏览器（站点在 Playwright 自带 Chromium 下打不开，本机开发用 msedge）----
BROWSER=msedge

# ---- 阿里云凭证：OSS 用（个人账号）----
# 部署架构：OSS / ACR / FC 在【个人账号】，短信在【企业账号】。
#   因此 OSS 与短信必须使用两套独立 AK，不能共用一组。
# 云端（FC）OSS 也可不填本组：给函数绑定个人账号 RAM 角色后，
#   运行时会自动注入 ALIBABA_CLOUD_SECURITY_TOKEN（storage.py 已支持），无需静态 AK。
# ⚠️ 不要在全文件重复定义同名键（曾有人把 ALIBABA_CLOUD_ACCESS_KEY_* 在短信章节
#   又写了一遍空值，后者覆盖前者导致 OSS 拿到空 AK）。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ---- 存储 ----
# OSS（留空则自动使用本地文件存储）
OSS_BUCKET=
OSS_REGION=oss-cn-shanghai
OSS_ENDPOINT=
OSS_KEY_PREFIX=repostbot/
# 强制指定存储实现：local | oss（排障时用；不填则按 OSS_BUCKET 自动判断）
STORAGE_BACKEND=

# ---- 单账号回退配置（本机未配置 accounts.json 时使用）----
FIRM_ID=firm_a
FIRM_NAME=
NOTIFY_EMAIL=
NOTIFY_PHONE=

# ---- 调度（阶段3 使用；单客户时通常一次就跑完）----
# 每轮最多处理几家（<=0 表示不限）；先按「最久没置顶」排序再截断
MAX_PER_RUN=5
# 点过「确定」后的保护窗口（天）：窗口内不再点击，避免同一 20 天周期二次消耗机会
ACCEPT_RETRY_GUARD_DAYS=3

# ---- 邮件回执（阶段4 使用）----
# 163 邮箱需在设置中开启 SMTP，并填写「授权码」，不是登录密码
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---- 告警接收人（阶段4 使用）----
# ADMIN_EMAIL 填**你自己**的邮箱：只在失败/异常时收告警，不要把技术故障推给客户
ADMIN_EMAIL=
ADMIN_PHONE=

# 失败时是否也通知客户（默认 false：失败只通知管理员，客户只看到成功的服务结果）
NOTIFY_CLIENT_ON_FAILURE=false

# ---- 短信回执（需企业实名认证阿里云账号）----
# 短信在【企业账号】，其余资源在个人账号，故短信使用独立的 AK：
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# 说明：sms.py 优先读取本组；未设置时回退到上方 ALIBABA_CLOUD_ACCESS_KEY_*。
#   拆分部署时必须显式填写本组（企业账号 AK），否则会用同账号 AK 调短信而失败。
# 客户成功回执模板（变量 ${time} ${nexttime}）
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 管理员失败告警模板（变量 ${name} ${reason} ${time}）
SMS_TEMPLATE_CODE_ALERT=
