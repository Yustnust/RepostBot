{
  "_说明": "账号配置样例。使用方式：复制为 accounts.json 并填写真实值（accounts.json 已被 .gitignore 忽略，不会提交）。密码不写在这里，用 env: 前缀指向环境变量。",
  "_范围": "v1 仅服务「上海臻至律师事务所」一家客户（firm_a）。多账号的数组结构已预留，但暂不启用——等客户增多再在数组里加项并启用调度。",
  "version": 1,
  "accounts": [
    {
      "id": "firm_a",
      "name": "示例律师事务所A",
      "enabled": true,
      "oa_user_ref": "env:FIRM_A_OA_USER",
      "oa_pass_ref": "env:FIRM_A_OA_PASS",
      "notify": {
        "email": "hr@firma.example.com",
        "phone": "13800000000",
        "email_enabled": true,
        "sms_enabled": false
      },
      "remark": "id 一经确定不要改动，它是 state.json 的主键"
    },
    {
      "id": "firm_b",
      "name": "示例律师事务所B",
      "enabled": true,
      "oa_user_ref": "env:FIRM_B_OA_USER",
      "oa_pass_ref": "env:FIRM_B_OA_PASS",
      "notify": {
        "email": "hr@firmb.example.com",
        "phone": "13900000000",
        "email_enabled": true,
        "sms_enabled": false
      },
      "remark": ""
    }
  ]
}
